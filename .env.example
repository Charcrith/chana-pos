# MariaDB connection (mysql2 / Drizzle)
DATABASE_URL=mysql://chana:chana_pass@127.0.0.1:3306/chana_oms

# Cookie session secret — at least 32 characters
SESSION_SECRET=dev-only-change-me-to-32chars-min

# Optional docker-compose overrides
MYSQL_ROOT_PASSWORD=chana_root
MYSQL_DATABASE=chana_oms
MYSQL_USER=chana
MYSQL_PASSWORD=chana_pass
